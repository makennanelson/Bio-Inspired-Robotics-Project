<mujoco model="planar_articulated_biped">
  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" cone="elliptic"/>
  <size njmax="1000" nconmax="200"/>
  <default>
    <joint limited="true" damping="0.02" armature="0.005" solreflimit="0.01 1"/>
    <geom condim="3" friction="0.9 0.01 0.001" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    <motor ctrllimited="true" ctrlrange="-120 120"/>
  </default>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="30 3 0.1" rgba="0.25 0.28 0.31 1"/>
    <site name="anchor_L" pos="0 0.075 0.04" size="0.012" rgba="1 0 0 1"/>
    <site name="anchor_R" pos="0 -0.075 0.04" size="0.012" rgba="1 0 0 1"/>
    <body name="torso" pos="0 0 0.82">
      <joint name="root_x" type="slide" axis="1 0 0" limited="false" damping="0.05" armature="0.01"/>
      <joint name="root_z" type="slide" axis="0 0 1" limited="false" damping="0.05" armature="0.01"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" limited="false" damping="0.15" armature="0.01"/>
      <geom name="torso_geom" type="box" pos="0 0 0" size="0.16 0.11 0.12" mass="9.0" rgba="0.85 0.35 0.12 1"/>
      <site name="com_site" pos="0 0 0" size="0.015" rgba="0 1 0 1"/>

      <!-- Left leg: actuated hip and running knee, passive ankle, and leg spring. -->
      <body name="leg_L" pos="0 0.075 -0.08">
        <joint name="hip_L" type="hinge" axis="0 1 0" range="-0.8 0.8" damping="0.03" armature="0.01"/>
        <joint name="spring_L" type="slide" axis="0 0 -1" range="-0.20 0.20" stiffness="1800" damping="35" springref="0"/>
        <geom name="thigh_L_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.035" mass="0.325" rgba="0.15 0.48 0.78 1"/>
        <body name="shank_L" pos="0 0 -0.32">
          <joint name="knee_L" type="hinge" axis="0 1 0" range="-0.15 1.8" stiffness="60" damping="2.5" springref="0" armature="0.005"/>
          <geom name="shank_L_geom" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.03" mass="0.325" rgba="0.15 0.48 0.78 1"/>
          <body name="foot_link_L" pos="0 0 -0.30">
            <joint name="ankle_L" type="hinge" axis="0 1 0" range="-0.7 0.7" stiffness="8" damping="0.5" springref="0" armature="0.002"/>
            <geom name="foot_L" type="capsule" fromto="0 0 -0.08 0.16 0 -0.08" size="0.04" mass="0.18" rgba="0.1 0.3 0.6 1"/>
            <site name="foot_site_L" pos="0.08 0 -0.08" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- Right leg mirrors the left leg. -->
      <body name="leg_R" pos="0 -0.075 -0.08">
        <joint name="hip_R" type="hinge" axis="0 1 0" range="-0.8 0.8" damping="0.03" armature="0.01"/>
        <joint name="spring_R" type="slide" axis="0 0 -1" range="-0.20 0.20" stiffness="1800" damping="35" springref="0"/>
        <geom name="thigh_R_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.035" mass="0.325" rgba="0.2 0.7 0.4 1"/>
        <body name="shank_R" pos="0 0 -0.32">
          <joint name="knee_R" type="hinge" axis="0 1 0" range="-0.15 1.8" stiffness="60" damping="2.5" springref="0" armature="0.005"/>
          <geom name="shank_R_geom" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.03" mass="0.325" rgba="0.2 0.7 0.4 1"/>
          <body name="foot_link_R" pos="0 0 -0.30">
            <joint name="ankle_R" type="hinge" axis="0 1 0" range="-0.7 0.7" stiffness="8" damping="0.5" springref="0" armature="0.002"/>
            <geom name="foot_R" type="capsule" fromto="0 0 -0.08 0.16 0 -0.08" size="0.04" mass="0.18" rgba="0.1 0.5 0.25 1"/>
            <site name="foot_site_R" pos="0.08 0 -0.08" size="0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <equality>
    <connect name="stance_L" site1="foot_site_L" site2="anchor_L"/>
    <connect name="stance_R" site1="foot_site_R" site2="anchor_R"/>
  </equality>
  <actuator>
    <motor name="drive" joint="root_x" gear="1" ctrlrange="-120 120"/>
    <motor name="vertical_support" joint="root_z" gear="1" ctrlrange="-30 260"/>
    <motor name="pitch_stabilizer" joint="root_pitch" gear="1" ctrlrange="-120 120"/>
    <motor name="hip_motor_L" joint="hip_L" gear="1" ctrlrange="-30 30"/>
    <motor name="hip_motor_R" joint="hip_R" gear="1" ctrlrange="-30 30"/>
    <motor name="knee_motor_L" joint="knee_L" gear="1" ctrlrange="-70 70"/>
    <motor name="knee_motor_R" joint="knee_R" gear="1" ctrlrange="-70 70"/>
    <motor name="spring_reset_L" joint="spring_L" gear="1" ctrlrange="-180 180"/>
    <motor name="spring_reset_R" joint="spring_R" gear="1" ctrlrange="-180 180"/>
  </actuator>
</mujoco>
